# ---------------------------------------------------------------------------
# Database — local dev via `docker compose up -d`, production via Supabase.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://sailors:sailors@localhost:5432/sailors_fa"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# Generate AUTH_SECRET with: npx auth secret
# Google OAuth: create credentials at https://console.cloud.google.com/apis/credentials
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Billplz (https://www.billplz.com) — payment gateway
# Sandbox dashboard: https://www.billplz-sandbox.com
# BILLPLZ_API_KEY: Billplz account -> API Keys (Secret Key)
# BILLPLZ_X_SIGNATURE_KEY: Billplz account -> API Keys (X Signature Key)
# BILLPLZ_COLLECTION_ID_FEES / _STORE: create two separate Billplz
#   collections (one for academy fees, one for store orders) and paste their
#   IDs here.
# ---------------------------------------------------------------------------
BILLPLZ_API_KEY=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_COLLECTION_ID_FEES=
BILLPLZ_COLLECTION_ID_STORE=
BILLPLZ_SANDBOX=true

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Resend (https://resend.com) — transactional email
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Sailors Football Academy <noreply@yourdomain.com>"

# ---------------------------------------------------------------------------
# Admin seed — creates one ADMIN user the first time `prisma/seed.ts` runs.
# ---------------------------------------------------------------------------
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Supabase — used for Postgres (see DATABASE_URL above) and Storage (admin
# image uploads for products / success stories / gallery).
# Project settings -> API for URL + keys; Storage -> create a public bucket
# named "media" before go-live.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cron — protects /api/cron/invoices (called by a scheduled job on the 1st of
# each month). Send as `Authorization: Bearer <CRON_SECRET>`.
# ---------------------------------------------------------------------------
CRON_SECRET=
