# ---------------------------------------------------------------------------
# Database — Supabase Postgres. Project settings -> Database -> Connection
# string (use the pooler on port 6543 for serverless hosts, direct 5432 for
# local `prisma` CLI usage). Prisma is the app's data-access layer; the
# schema itself is applied with supabase/migrations/0001_init.sql.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase — Project settings -> API.
# NEXT_PUBLIC_* vars are safe to expose to the browser (anon key is
# RLS-protected); SUPABASE_SERVICE_ROLE_KEY is server-only.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Auth — Supabase Auth (Authentication -> Providers -> Email + Google).
# Google OAuth: create credentials at https://console.cloud.google.com/apis/credentials,
# then paste the client id/secret in the Supabase dashboard and add
# https://<your-domain>/auth/callback to both the Google console and
# Authentication -> URL Configuration -> Redirect URLs. Recommended:
# disable "Confirm email" (Authentication -> Sign In / Providers -> Email)
# for the portal's instant sign-up UX.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Dev-only — ENABLE_MOCK_GATEWAY=true fakes Billplz bills and sends customers
# to local /checkout/mock-gateway + /pay/mock-gateway pages so checkout and
# fee payment are testable without Billplz keys. Never enable in production.
# ---------------------------------------------------------------------------
ENABLE_MOCK_GATEWAY=false

# ---------------------------------------------------------------------------
# Billplz (https://www.billplz.com) — payment gateway
# Sandbox dashboard: https://www.billplz-sandbox.com
# BILLPLZ_API_KEY: Billplz account -> API Keys (Secret Key)
# BILLPLZ_X_SIGNATURE_KEY: Billplz account -> API Keys (X Signature Key)
# BILLPLZ_COLLECTION_ID_FEES / _STORE: create two separate Billplz
#   collections (one for academy fees, one for store orders) and paste their
#   IDs here.
# ---------------------------------------------------------------------------
BILLPLZ_API_KEY=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_COLLECTION_ID_FEES=
BILLPLZ_COLLECTION_ID_STORE=
BILLPLZ_SANDBOX=true

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Resend (https://resend.com) — transactional email
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Sailors Football Academy <noreply@yourdomain.com>"

# ---------------------------------------------------------------------------
# Admin seed — creates one ADMIN user the first time `prisma/seed.ts` runs.
# ---------------------------------------------------------------------------
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Cron — protects /api/cron/invoices (called by a scheduled job on the 1st of
# each month). Send as `Authorization: Bearer <CRON_SECRET>`.
# ---------------------------------------------------------------------------
CRON_SECRET=
